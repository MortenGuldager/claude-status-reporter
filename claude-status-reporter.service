[Unit]
Description=Claude Code session status reporter

[Service]
Type=simple
# Optional: missing file is fine — service starts with default backend (stdout).
EnvironmentFile=-%h/.config/claude-status-reporter/config.env
ExecStart=/opt/claude-status-reporter/bin/claude-status-reporter.sh
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
