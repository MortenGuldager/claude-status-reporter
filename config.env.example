# claude-status-reporter configuration.
#
# Edit ~/.config/claude-status-reporter/config.env and then:
#   systemctl --user restart claude-status-reporter
#
# Lines are sourced by both bash and systemd's EnvironmentFile parser.
# Quote values that contain spaces or special characters.

# --- Backend ---------------------------------------------------------------
#
# One of: none, stdout, file, mqtt, http.
#   none    Disable publishing entirely.
#   stdout  Write each payload to the systemd journal (default).
#           Tail with: journalctl --user -u claude-status-reporter -f
#   file    Append each payload as one JSON line to REPORTER_FILE_PATH.
#   mqtt    Publish via mosquitto_pub, one retained topic per session (see the
#           mqtt section below). Requires mosquitto-clients and a broker that
#           speaks MQTT 5 (the reporter connects with -V 5).
#   http    POST each JSON payload to REPORTER_HTTP_URL.

REPORTER_BACKEND="stdout"

# Seconds between keep-alive reports. Changes are sent immediately
# regardless of this interval. For the mqtt backend, each keep-alive also
# refreshes every live session's retained expiry (see REPORTER_STATUS_EXPIRY).
REPORTER_KEEPALIVE=60

# Seconds to wait after a filesystem change before reading state. This
# debounces bursts of changes and lets very short-lived sessions (appear,
# run one prompt, exit) vanish before they are read, so they never produce
# a red/green flicker downstream. Set to 0 to read immediately.
REPORTER_SETTLE=1

# --- file backend ----------------------------------------------------------
# Path is expanded by bash when the script sources this file, so $HOME works.
#REPORTER_FILE_PATH="$HOME/claude-status.jsonl"

# --- mqtt backend ----------------------------------------------------------
# WARNING: public brokers (test.mosquitto.org, broker.hivemq.com, ...) are
# fully public. If you publish to one, pick a topic that is not guessable
# (e.g. a UUID) and assume the data is visible to the world. For anything
# you would rather not broadcast, run your own broker.
#
# Topic convention for the claude-tools family: publish under the shared
# claude_info/ root as claude_info/status/<reporter>, so the claude-top viewer
# needs only one ACL (read claude_info/#) to see this and the usage tree.
# <reporter> is a stable, hard-to-guess name for THIS machine.
#
# REPORTER_MQTT_TOPIC is the base, not a leaf: the reporter publishes one
# retained message per session under it, at
#   claude_info/status/<reporter>/<sessionId> = "#rrggbb"
# Each session is its own retained topic so a late subscriber gets the exact
# live set (retained keeps only one message per topic — a shared topic could
# never represent more than one session). A session that ends is cleared with
# an empty retained message; subscribers should treat an empty payload on a
# status topic as "this session is gone".
#REPORTER_MQTT_HOST="test.mosquitto.org"
#REPORTER_MQTT_PORT=1883
#REPORTER_MQTT_TOPIC="claude_info/status/my-machine"
#REPORTER_MQTT_USER=""
#REPORTER_MQTT_PASS=""

# Broker-side TTL for a session's retained message, in seconds, set as the
# MQTT-5 message-expiry-interval. Every keep-alive refreshes it, so it only
# ever fires for a reporter that has gone silent (crash, power loss, lost
# network) without sending tombstones — the broker then drops the stale
# retained message on its own. Must be larger than REPORTER_KEEPALIVE;
# defaults to 3 × REPORTER_KEEPALIVE.
#REPORTER_STATUS_EXPIRY=180

# --- http backend ----------------------------------------------------------
#REPORTER_HTTP_URL=""

# --- Colors ----------------------------------------------------------------
# The reporter maps each session's status to an RGB color (hex #rrggbb) and
# publishes that to the subscriber, so the display hardware doesn't need to
# know about Claude-specific status names. Override these to repaint without
# reflashing the indicator.

#REPORTER_COLOR_BUSY="#ff0000"
#REPORTER_COLOR_WAITING="#ffb400"
#REPORTER_COLOR_IDLE="#00dc00"
#REPORTER_COLOR_INFO="#00dc00"
#REPORTER_COLOR_UNKNOWN="#3c3c3c"

# --- Advanced --------------------------------------------------------------
# Parent directory holding one subdirectory per Claude account, each its own
# CLAUDE_CONFIG_DIR. Sessions are aggregated across every account, i.e.
# $CLAUDE_HOMES_DIR/*/sessions/*.json. New accounts are picked up
# automatically. Defaults to $HOME/.claudes.
#CLAUDE_HOMES_DIR="$HOME/.claudes"
